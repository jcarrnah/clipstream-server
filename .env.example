# Jellyfin (reachable from the container). Callers must present a Jellyfin sign-in token.
JELLYFIN_URL=http://192.168.1.10:8096

# Dispatcharr: a service account used to read channels and the guide.
DISPATCHARR_URL=http://192.168.1.10:9191
# What TVs use to play streams (defaults to DISPATCHARR_URL). Use your public address for viewers away from home.
DISPATCHARR_PUBLIC_URL=https://dispatch.example.com
# Signed stream links (recommended): this server's own DNS-only address; then block /proxy/ on Dispatcharr's public one.
# STREAM_PUBLIC_URL=https://live.example.com
DISPATCHARR_USERNAME=clipstream
DISPATCHARR_PASSWORD=change-me
# Backup streams from your other IPTV sources, hidden duplicates, kept channel numbers
# (needs an Admin Dispatcharr user; see docs/SETUP.md 2.6).
# DISPATCHARR_MANAGE_CHANNELS=true

# Calendar (optional): each one you set is merged in.
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

# Game slots show from 30 min before the real start (ESPN's schedule) to 30 min after the final.
# EVENT_PREGAME_MINUTES=30
# EVENT_POSTGAME_MINUTES=30

# Listings like "7pm Devils at Rangers" are read in this time zone.
LOCAL_TIMEZONE=America/New_York
# CATEGORIES_FILE=/config/categories.json

# Problem reports from the apps, posted to Discord (all optional; see docs/SETUP.md)
# DISCORD_REPORT_WEBHOOK=https://discord.com/api/webhooks/...
# DISCORD_REPORT_MENTION=<@123456789012345678>
# JELLYFIN_PUBLIC_URL=https://watch.example.com
# REPORTS_FILE=/data/reports.jsonl
